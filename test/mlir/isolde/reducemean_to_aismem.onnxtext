// RUN: onnx-mlir --EmitSPADEMLIR --printIR %s | FileCheck %s

// Sequence mean pool + classifier head of the radar encoder
// (radar_attention tf_pool / tf_head) on RedMulE:
//   ReduceMean over the 12 frames: Y = POOL . pad16(h) + 0 with the resident
//     POOL = fp16(1/12) (0x2D55) in columns 0..11; every row of Y holds the
//     mean, the result stays in SPM;
//   MatMul [1,16] x [16,4]: X = the pooled SPM buffer as is, W = the head
//     padded to 16x16 at compile time, Y = 0;
//   only row 0, columns 0..3 are downloaded (omrm_download_tile_f16).
<
ir_version: 9,
opset_import: [ "" : 18 ]
>
agraph (float16[1,12,16] h) => (float16[1,4] logits)
{
    axes = Constant <value = int64[1] {1}> ()
    pooled = ReduceMean <keepdims = 0> (h, axes)
    ws = Constant <value = int64[2] {16, 4}> ()
    w32 = ConstantOfShape <value = float[1] {0.5}> (ws)
    w = Cast <to = 10> (w32)
    logits = MatMul (pooled, w)
}
// CHECK-LABEL: func.func @main_graph
// CHECK-SAME:    ([[H:%.+]]: memref<1x12x16xf16>
// CHECK-NOT:   affine.for
// CHECK:       [[W:%.+]] = "aismem.SPMAlloc"() <{name = "{{.*}}.H|0", resident = false, row = {{[0-9]+}} : i32, rows = 16
// CHECK-NEXT:  "aismem.RedMulEUploadTile"([[H]], [[W]]) <{col_offset = 0 : i32, cols = 16 : i32, dst_cols = 16 : i32, dst_rows = 16 : i32, {{.*}}, rows = 12 : i32
// CHECK:       [[POOL:%.+]] = "aismem.SPMAlloc"() <{name = "aismem.meanpool12", resident = true
// CHECK:       [[P:%.+]] = "aismem.SPMAlloc"() <{name = "{{.*}}.Y"
// CHECK-NEXT:  [[Z:%.+]] = "aismem.RedMulEZero"([[P]])
// CHECK-NEXT:  [[G:%.+]] = "aismem.RedMulEGEMM"([[POOL]], [[W]], [[P]], {{.*}}[[Z]])
// CHECK-NEXT:  [[T:%.+]] = "aismem.RedMulEWait"([[G]])
// The head: X = the pooled buffer, W resident.
// CHECK:       [[HW:%.+]] = "aismem.SPMAlloc"() <{name = "{{.*}}.W", resident = true
// CHECK:       [[Y:%.+]] = "aismem.SPMAlloc"() <{name = "{{.*}}.Y"
// CHECK-NEXT:  [[Z2:%.+]] = "aismem.RedMulEZero"([[Y]])
// CHECK-NEXT:  [[G2:%.+]] = "aismem.RedMulEGEMM"([[P]], [[HW]], [[Y]], [[Z2]], [[T]])
// CHECK-NEXT:  [[T2:%.+]] = "aismem.RedMulEWait"([[G2]])
// CHECK-NEXT:  [[OUT:%.+]] = memref.alloc() {{.*}} : memref<1x4xf16>
// CHECK-NEXT:  "aismem.RedMulEDownload"([[Y]], [[OUT]], [[T2]]) <{cols = 4 : i32, dst_ld = 4 : i32, dst_offset = 0 : i32, elements = 4 : i32, tile = 0 : i32}>
// CHECK-NOT:   affine.for
// CHECK:       return [[OUT]]

// CHECK-LABEL: func.func @main_graph_preload
// CHECK-DAG:   "krnl.global"() {alignment = 16 : i64, name = "aismem_meanpool_12", shape = [12, 16], value = dense<"0x{{((552D){12}(0000){4}){11}(552D){12}(0000){3}0000}}"> : tensor<12x16xf16>}
// The head W: 16 rows of 4 columns (0.5 = 0x3800), zero padded to 16x16.
// CHECK-DAG:   "krnl.global"() {alignment = 16 : i64, name = "constant_{{[0-9]+}}_spm_r0c0_16x4_16", shape = [16, 16], value = dense<"0x{{((0038){4}(0000){12}){15}(0038){4}(0000){11}0000}}"> : tensor<16x16xf16>}
