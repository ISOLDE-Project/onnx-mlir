// RUN: onnx-mlir --EmitSPADEMLIR --printIR %s | FileCheck %s

// Input projection + positional encoding of the radar encoder on RedMulE:
//   MatMul [1,12,32] x [32,16]: Y = 0, two K-tiles accumulate in Y;
//   Add    [1,12,16] + [12,16]: X = identity, W = pad16(P), Y = MatMul result
//                               (in place: it has no other user).
// The f32 MatMul is not a RedMulE shape/type and stays on the Krnl path.
<
ir_version: 9,
opset_import: [ "" : 18 ]
>
agraph (float16[1,12,32] x, float[12,16] a, float[16,4] b) => (float16[1,12,16] y, float[12,4] z)
{
    ws = Constant <value = int64[2] {32, 16}> ()
    w32 = ConstantOfShape <value = float[1] {0.5}> (ws)
    w = Cast <to = 10> (w32)
    ps = Constant <value = int64[2] {12, 16}> ()
    p32 = ConstantOfShape <value = float[1] {0.25}> (ps)
    p = Cast <to = 10> (p32)
    e = MatMul (x, w)
    y = Add (e, p)
    z = MatMul (a, b)
}
// CHECK-LABEL: func.func @main_graph
// CHECK-SAME:    ([[X:%.+]]: memref<1x12x32xf16>
// MatMul: both 16x16 K-tiles of W are resident, X is split into two tiles.
// CHECK:     [[W0:%.+]] = "aismem.SPMAlloc"() <{name = "{{.*}}W[0,:]", resident = true
// CHECK:     [[W1:%.+]] = "aismem.SPMAlloc"() <{name = "{{.*}}W[16,:]", resident = true
// CHECK:     [[X0:%.+]] = "aismem.SPMAlloc"() <{name = "{{.*}}X[:,0]"
// CHECK-NEXT: "aismem.RedMulEUploadTile"([[X]], [[X0]]) <{col_offset = 0 : i32
// CHECK:     [[X1:%.+]] = "aismem.SPMAlloc"() <{name = "{{.*}}X[:,16]"
// CHECK-NEXT: "aismem.RedMulEUploadTile"([[X]], [[X1]]) <{col_offset = 16 : i32
// CHECK:     [[Y:%.+]] = "aismem.SPMAlloc"() <{name = "{{.*}}Y"
// CHECK-NEXT: [[Z:%.+]] = "aismem.RedMulEZero"([[Y]]) <{elements = 192 : i32
// CHECK-NEXT: [[G0:%.+]] = "aismem.RedMulEGEMM"([[X0]], [[W0]], [[Y]], [[Z]])
// CHECK-NEXT: [[T0:%.+]] = "aismem.RedMulEWait"([[G0]])
// CHECK-NEXT: "aismem.RedMulEGEMM"([[X1]], [[W1]], [[Y]], [[T0]])
// Add: X = the resident identity, W = pad16(P) (resident), Y = e in place.
// CHECK:     [[I:%.+]] = "aismem.SPMAlloc"() <{name = "aismem.identity12x16", resident = true, row = {{[0-9]+}} : i32, rows = 12
// CHECK:     [[P:%.+]] = "aismem.SPMAlloc"() <{name = "{{.*}}W", resident = true, row = {{[0-9]+}} : i32, rows = 16
// CHECK:     "aismem.RedMulEGEMM"([[I]], [[P]], [[Y]],
// CHECK:     "aismem.RedMulEDownload"([[Y]],
// The f32 MatMul stays on the Krnl path:
// CHECK:     affine.for
// CHECK:     return

// CHECK-LABEL: func.func @main_graph_preload
// CHECK:     "krnl.global"() {alignment = 16 : i64, name = "aismem_identity_12x16"
