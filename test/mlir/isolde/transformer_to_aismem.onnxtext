// RUN: onnx-mlir --EmitSPADEMLIR --printIR %s | FileCheck %s

// End to end: com.isolde encoder layer (scales already folded, weights as
// graph inputs, so they are streamed per call rather than resident) ->
// onnx -> aisle -> aismem RedMulE schedule with SPM-resident activations.
// Attention's Q, K and V run on the three RedMulE tiles at once; everything
// else on tile 0.  The layer input is uploaded once per tile that reads it,
// the output downloaded once; in between, data stays in SPM except K and V,
// which reach tile 0 through data memory (SPMMoveTile).
<
ir_version: 9,
opset_import: [ "" : 18, "com.isolde" : 1 ]
>
agraph (float16[1,12,16] h, float16[16,16] wq, float16[16,16] wk, float16[16,16] wv, float16[16,16] wo, float16[16,48] w1, float16[48,16] w2) => (float16[1,12,16] y)
{
    y = com.isolde.EncoderLayer <scale = 1.0, post_scale = 1.0> (h, wq, wk, wv, wo, w1, w2)
}

<
opset_import: [ "" : 18, "com.isolde" : 1 ],
domain: "com.isolde"
>
EncoderLayer <scale, num_heads: int = 1, post_scale: float = 1.0, normalization: string = "relu"> (H, Wq, Wk, Wv, Wo, W1, W2) => (Y) {
    attn = com.isolde.MultiHeadAttention <num_heads: int = @num_heads, scale: float = @scale, post_scale: float = @post_scale, normalization: string = @normalization> (H, H, Wq, Wk, Wv, Wo)
    H1 = Add (H, attn)
    ffn = com.isolde.PositionwiseFeedForward (H1, W1, W2)
    Y = Add (H1, ffn)
}

<
opset_import: [ "" : 18 ],
domain: "com.isolde"
>
MultiHeadAttention <scale, num_heads: int = 1, post_scale: float = 1.0, normalization: string = "relu"> (Xq, Xkv, Wq, Wk, Wv, Wo) => (Y) {
    q = MatMul (Xq, Wq)
    k = MatMul (Xkv, Wk)
    v = MatMul (Xkv, Wv)
    kt = Transpose <perm = [0, 2, 1]> (k)
    qkt = MatMul (q, kt)
    s32 = Constant <value_float: float = @scale> ()
    s = CastLike (s32, qkt)
    sc = Mul (qkt, s)
    r = Relu (sc)
    p32 = Constant <value_float: float = @post_scale> ()
    p = CastLike (p32, r)
    a = Mul (r, p)
    o = MatMul (a, v)
    Y = MatMul (o, Wo)
}

<
opset_import: [ "" : 18 ],
domain: "com.isolde"
>
PositionwiseFeedForward (X, W1, W2) => (Y) {
    u = MatMul (X, W1)
    r = Relu (u)
    Y = MatMul (r, W2)
}

// CHECK-LABEL: func.func @main_graph
// CHECK-SAME:    ([[H:%.+]]: memref<1x12x16xf16>
// CHECK-SAME:    aismem.spm_rows_used = {tile0 = {{[0-9]+}} : i64, tile1 = {{[0-9]+}} : i64, tile2 = {{[0-9]+}} : i64}

// MultiHeadAttention: h is uploaded to each of the three tiles; on tile 0 it
// is also the residual accumulator.
// CHECK:     [[X:%.+]] = "aismem.SPMAlloc"() <{name = "{{.*}}Xq", resident = false, row = [[XR:[0-9]+]] : i32, rows = 12 : i32, tile = 0
// CHECK-NEXT: "aismem.RedMulEUploadTile"([[H]], [[X]]
// CHECK:     [[X1:%.+]] = "aismem.SPMAlloc"() <{name = "{{.*}}Xkv.t1", {{.*}}tile = 1
// CHECK-NEXT: "aismem.RedMulEUploadTile"([[H]], [[X1]]
// CHECK:     [[X2:%.+]] = "aismem.SPMAlloc"() <{name = "{{.*}}Xkv.t2", {{.*}}tile = 2
// CHECK-NEXT: "aismem.RedMulEUploadTile"([[H]], [[X2]]
// Q, K and V launched on tiles 0, 1, 2, then one wait for all three.
// CHECK:     [[Q:%.+]] = "aismem.SPMAlloc"() <{name = "{{.*}}Q", {{.*}}tile = 0
// CHECK:     [[LQ:%.+]] = "aismem.RedMulEGEMM"([[X]], {{%.+}}, [[Q]], {{.*}}tile = 0
// CHECK:     [[K:%.+]] = "aismem.SPMAlloc"() <{name = "{{.*}}K", {{.*}}rows = 12 : i32, tile = 1
// CHECK:     [[LK:%.+]] = "aismem.RedMulEGEMM"([[X1]], {{%.+}}, [[K]], {{.*}}tile = 1
// CHECK:     [[V:%.+]] = "aismem.SPMAlloc"() <{name = "{{.*}}V", {{.*}}rows = 12 : i32, tile = 2
// CHECK:     [[LV:%.+]] = "aismem.RedMulEGEMM"([[X2]], {{%.+}}, [[V]], {{.*}}tile = 2
// CHECK-NEXT: [[T:%.+]] = "aismem.RedMulEWait"([[LQ]], [[LK]], [[LV]]) <{mask = 7 : i32}>
// K^T (transposed on the way) and V reach tile 0 zero padded to 16 rows.
// CHECK:     [[KT:%.+]] = "aismem.SPMAlloc"() <{name = "{{.*}}K^T|0", {{.*}}rows = 16 : i32, tile = 0
// CHECK-NEXT: "aismem.SPMMoveTile"([[K]], [[KT]], [[T]]) <{dst_rows = 16 : i32, dst_tile = 0 : i32, rows = 12 : i32, src_tile = 1 : i32, transpose = true}>
// CHECK:     [[VW:%.+]] = "aismem.SPMAlloc"() <{name = "{{.*}}V|0", {{.*}}rows = 16 : i32, tile = 0
// CHECK-NEXT: "aismem.SPMMoveTile"([[V]], [[VW]], [[T]]) <{dst_rows = 16 : i32, dst_tile = 0 : i32, rows = 12 : i32, src_tile = 2 : i32, transpose = false}>
// CHECK-NOT: "aismem.SPMTranspose"
// CHECK:     [[S:%.+]] = "aismem.SPMAlloc"() <{name = "{{.*}}S"
// CHECK:     "aismem.RedMulEGEMM"([[Q]], [[KT]], [[S]],
// CHECK:     "aismem.SPMRelu"([[S]],
// CHECK:     [[O:%.+]] = "aismem.SPMAlloc"() <{name = "{{.*}}O"
// CHECK:     "aismem.RedMulEGEMM"([[S]], [[VW]], [[O]],
// Residual in place: Y = O . Wo + h accumulates into h's own rows.
// CHECK:     "aismem.RedMulEGEMM"([[O]], {{%.+}}, [[X]],

// PositionwiseFeedForward reads the attention result where it is and
// accumulates into it again.
// CHECK:     [[U0:%.+]] = "aismem.SPMAlloc"() <{name = "{{.*}}U0"
// CHECK:     "aismem.RedMulEGEMM"([[X]], {{%.+}}, [[U0]],
// CHECK:     "aismem.SPMRelu"([[U0]],
// CHECK:     "aismem.SPMRelu"
// CHECK:     "aismem.SPMRelu"
// CHECK:     "aismem.RedMulEGEMM"([[U0]], {{%.+}}, [[X]],
// CHECK:     "aismem.RedMulEGEMM"({{%.+}}, {{%.+}}, [[X]],
// CHECK:     "aismem.RedMulEGEMM"({{%.+}}, {{%.+}}, [[X]],
// CHECK:     "aismem.RedMulEWait"
// The only download (besides the two moves):
// CHECK:     "aismem.RedMulEDownload"([[X]],
// CHECK-NOT: "aismem.RedMulE
// CHECK:     return
// CHECK-NOT: func.func @main_graph_preload
